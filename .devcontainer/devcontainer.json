{
  // Rootless podman dev container for Zed (requires "use_podman": true in Zed's settings).
  // krun microVMs can't be used: Zed connects via `podman exec`, which krun doesn't support.
  "name": "teams_meeting",
  "build": { "dockerfile": "Containerfile" },

  // Zed always mounts the project itself, but can't pass mount options such as ":z" (SELinux
  // relabeling, without which the container can't access the project). So Zed's own mount is
  // redirected to an unused tmpfs, and the project is mounted with ":z" in runArgs instead.
  // Zed requires workspaceFolder whenever workspaceMount is set; it's the folder Zed opens.
  // A fixed path, because Zed doesn't substitute variables inside it (${containerWorkspaceFolder}
  // would contain a literal "${localWorkspaceFolderBasename}").
  "workspaceMount": "type=tmpfs,target=/workspaces/.unused-zed-mount",
  "workspaceFolder": "/workspaces/teams_meeting",

  "runArgs": [
    "--volume=${localWorkspaceFolder}:${containerWorkspaceFolder}:z",
    "--cap-drop=ALL",
    // Any --security-opt also stops Zed from adding --security-opt=label=disable,
    // so the container stays confined by SELinux
    "--security-opt=no-new-privileges",
    // Real home directory for the user Zed maps in with --userns=keep-id (default would be /)
    "--passwd-entry=$USERNAME:*:$UID:$GID::/home/$USERNAME:/bin/bash",
    // Run the container's main process as that user too (Zed's image sets USER root). Podman
    // gives new volumes to this user, so the volumes below are writable.
    "--user=${localEnv:USER}"
  ],
  "remoteUser": "${localEnv:USER}",

  // Named podman volumes, the only storage besides the project folder; nothing else from the
  // host (home directory, ~/.ssh, ssh-agent socket) is mounted.
  "mounts": [
    // Separate pixi environment: the host's .pixi contains host paths and must not be rebuilt
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume",
    // Persistent home: pixi cache, Teams token cache, meeting log, Zed's remote server
    "source=${localWorkspaceFolderBasename}-home,target=/home/${localEnv:USER},type=volume"
  ],

  // Array form: Zed wraps string commands in "sh -c" twice and loses the arguments
  "postCreateCommand": ["pixi", "install"]
}
